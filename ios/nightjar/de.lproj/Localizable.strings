"Passes" = "Durchläufe";
"Passes: %lld · new devices: %lld · drift: %lld · ports knocked: %lld" = "Durchläufe: %lld · neue Geräte: %lld · Drift: %lld · angeklopfte Ports: %lld";
"Paused — the house sleeps; it resumes when you return" = "Pausiert — das Haus schläft; es setzt fort, wenn du zurückkehrst";
