"Developer console" = "Entwicklerkonsole";
"Developer options" = "Entwickleroptionen";
"Discard changes" = "Änderungen verwerfen";
"Download" = "Herunterladen";
"Download it" = "Es herunterladen";
"Edit room…" = "Raum bearbeiten…";
"File" = "Datei";
