"%@ keeps the hours %lld:00–%lld:00 — %lld%% of its appearances fall there." = "%@ hält die Stunden %lld:00–%lld:00 — %lld%% seiner Auftritte fallen dorthin.";
"%@ knocked this phone %lld times in a minute" = "%@ klopfte in einer Minute %lld Mal an dieses Telefon";
