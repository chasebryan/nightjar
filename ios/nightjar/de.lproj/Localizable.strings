"%@ was seen at %@ — outside the hours the house knows it by (%lld:00–%lld:00)." = "%@ wurde %@ gesehen — außerhalb der Stunden, zu denen das Haus es kennt (%lld:00–%lld:00).";
"%@ wears the gateway's name (“%@”)" = "%@ trägt den Namen des Gateways (“%@”)";
