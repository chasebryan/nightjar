"redisprobe: %@" = "redisprobe: %@";
"redisprobe: PONG with NO password asked — an unauthenticated Redis. Anyone on this wire can read and write the whole store, and its config. Critical." = "redisprobe: 비밀번호를 묻지 않고 PONG — 인증 없는 Redis입니다. 이 선의 누구나 저장소 전체와 그 설정을 읽고 쓸 수 있습니다. 치명적.";
"redisprobe: give host[:port] — redisprobe 192.168.1.10" = "redisprobe: 호스트[:포트]를 주세요 — redisprobe 192.168.1.10";
