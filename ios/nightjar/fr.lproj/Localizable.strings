"mqttprobe: the greeting never built." = "mqttprobe : la salutation ne s'est jamais construite.";
"mqttprobe: the greeting never left." = "mqttprobe : la salutation n'est jamais partie.";
"mqttprobe: whatever answered is not speaking MQTT." = "mqttprobe : ce qui a répondu ne parle pas MQTT.";
