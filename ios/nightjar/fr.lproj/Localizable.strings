"Nothing to forgive." = "Rien à pardonner.";
"Reading %@…" = "Lecture de %@…";
"Rendering %@ in her browser…" = "Affichage de %@ dans son navigateur…";
"Rest well." = "Repose-toi bien.";
"Revised — %@ (%@)." = "Révisé — %@ (%@).";
"Revising…" = "Je révise…";
"Running clean. You?" = "Tout tourne proprement. Et toi ?";
