"Running speed/cadence sensor" = "Sensor de velocidade/cadência de corrida";
"Seal" = "Selar";
"That envelope is from a newer Vault than this one." = "Esse envelope é de um Vault mais recente do que este.";
"That is not an NJCF envelope." = "Isso não é um envelope NJCF.";
"That protection wants a password." = "Essa proteção pede uma palavra-passe.";
"That recipient key would not read — it wants a P-256 public key as base64." = "Essa chave de destinatário não se leu — pede uma chave pública P-256 em base64.";
"That recipient key would not read — it wants to be base64." = "Essa chave de destinatário não se leu — pede estar em base64.";
"The envelope failed." = "O envelope falhou.";
"The envelope is damaged." = "O envelope está danificado.";
"The envelope wants to arrive as base64." = "O envelope pede chegar em base64.";
