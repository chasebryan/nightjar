"ptpprobe: give host[:port] — ptpprobe 192.168.1.10" = "ptpprobe: informe host[:port] — ptpprobe 192.168.1.10";
"ptpprobe: no clock at %@ answered the management question — PTP's management plane is off, elsewhere, or the clock answers only its grandmaster." = "ptpprobe: nenhum relógio em %@ respondeu à pergunta de gerenciamento — o plano de gerenciamento do PTP está desligado, em outro lugar, ou o relógio responde apenas ao seu grandmaster.";
"ptpprobe: one management GET of the published description dataset — the clock's time was never set, stepped, or asked to move; a plant's clock is read here the way its own management station reads it." = "ptpprobe: um GET de gerenciamento do conjunto de dados de descrição publicado — o tempo do relógio nunca foi definido, avançado ou solicitado a se mover; o relógio de uma planta é lido aqui do jeito que a sua própria estação de gerenciamento o lê.";
"ptpprobe: the clock at %@ describes itself — %@." = "ptpprobe: o relógio em %@ se descreve — %@.";
"read and write protection — the strongest word this ledger carries" = "proteção de leitura e escrita — a palavra mais forte que este registro carrega";
"reconfig" = "reconfiguração";
"remote diagnosis" = "diagnóstico remoto";
"remote logging" = "registro remoto";
"reset" = "reiniciar";
"resume" = "retomar";
"revision" = "revisão";
