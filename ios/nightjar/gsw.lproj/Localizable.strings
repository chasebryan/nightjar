"%@ is unplaced — it waits in the Map's tray for you to say where it sits." = "%@ isch nid platziert — es wartet im Schale vo de Charte, bis de seisch, wo s sitzt.";
"%@ new this watch" = "%@ neu i dere Wacht";
"%@ sits in %@ — your placement, kept by the Map." = "%@ sitzt i %@ — diini Platzierig, vo de Charte ghalte.";
"%@ tracker-shaped · %@" = "%@ trackerförmig · %@";
"%@ unknown" = "%@ unbekannt";
