/* Permission prompts, in the operator's own tongue. */
"NSBluetoothAlwaysUsageDescription" = "nightjar lost uf Bluetooth-Grät um dech ume ond loggt, was es ghört. Wenn du de Send-Tab bruuchsch, cha es ou e Nutziig azeige, wo du iitippsch, ond uf Grät schriibe, wo du uuswählsch. Lose verbindet sech nie met öppisem.";
"NSLocalNetworkUsageDescription" = "nightjar schickt Nutziige a Grät i diim lokale Netz ond überchunnt Nutziige vo ihne — nume a Adrässe, wo du iitippsch, ond nume solang d App offe esch.";
"NSLocationWhenInUseUsageDescription" = "nightjar bruucht dii Standort während de Nutzig für zwöi Sache: für de Kompass, wo dini Richtig ond Bewegigsrichtig bruucht, zum dech zu somene Bluetooth-Grät z füehre, wo sis Ohr grad ghört, während du druf zue laufsch; ond für Skelli ihres Gspüri für Orte, wo ihre erlaubt z säge, wo uf de Wält du besch, ond dini lokali Ziit ond s Wätter abzläse. Dii Standort wird nie gspeicheret. Koordinate gönd nume i dem Momänt a de Wätterdienst, wo du Skelli nach em Wätter frogsch.";
"NSCameraUsageDescription" = "nightjar bruucht d Kamera, zum Blink-Überträgige z empfange — Nachrichte, wo es anders vo diine Grät als endlosi Reih vo QR-Einzelbilder zeigt — aber nume solang du de Blink-Empfänger im Knocktalk-Tab offe hesch. D Bilder wärde im Momänt entschlüsslet; es wärde kei Fotos ond keis Video ufgnoh oder gspeicheret.";
"NFCReaderUsageDescription" = "nightjar liest en Tag, wo du as Telefon hebsch, wenn du de Coin bruuchsch — en physische Schlüssel, wo du im EMCON-Tab beanspruchsch — ond wenn du d EMCON-Tag-Zählig uf diine eigete Charte ond Tags laufe lahsch. Tags wärde nume i dem Momänt gläse, wo du tippsch; de Coin bhaltet nume en Hash, ond d Zählig bhaltet nüt als das, wo sie der zeigt.";
"NSMicrophoneUsageDescription" = "nightjar lost uf Chirp-Überträgige — churzi Nachrichte, wo es anders vo diine Grät als hörbari Tön schickt — aber nume solang du de Chirp-Zueloser im Knocktalk-Tab offe hesch. Nüt wird ufgnoh oder gspeicheret; d Tön wärde im Momänt entschlüsslet ond vergässe.";
"NSHealthShareUsageDescription" = "nightjar liest d Wärt, wo dini Apple Watch scho sammlet — Herzfrequänz, Bluet-Suurstoff, Atem, Handglenk-Temperatur ond Schlaf — zum de Zuestand vo de Person, wo s Grät bedient, näbe de Zuestand vom Huus z zeige. Es liest nume; nüt wird i dini Gsundheitsdate gschriibe, ond nüt verlaht das Telefon.";
