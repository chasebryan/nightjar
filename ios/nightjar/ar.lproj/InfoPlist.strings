/* Permission prompts, in the operator's own tongue. */
"NSBluetoothAlwaysUsageDescription" = "يستمع nightjar إلى أجهزة Bluetooth من حولك ويسجل ما يسمعه. وإذا استخدمت تبويب Send، فيمكنه أيضًا بث حمولة تكتبها والكتابة إلى أجهزة تختارها. الاستماع لا يتصل أبدًا بأي شيء.";
"NSLocalNetworkUsageDescription" = "يرسل nightjar حمولات إلى أجهزة على شبكتك المحلية ويستقبل حمولات منها — فقط إلى عناوين تكتبها بنفسك، وفقط بينما التطبيق مفتوح.";
"NSLocationWhenInUseUsageDescription" = "يستخدم nightjar موقعك أثناء الاستخدام لغرضين: بوصلته، التي تستخدم اتجاهك واتجاه سيرك لترشدك نحو جهاز Bluetooth تسمعه أذنه أثناء مشيك إليه؛ وإحساس Skelli بالمكان، الذي يتيح لها تسمية موقعك في العالم وقراءة وقتك المحلي والطقس عندك. لا يُخزَّن موقعك أبدًا. ولا تُرسَل الإحداثيات إلى خدمة الطقس إلا في اللحظة التي تسأل فيها Skelli عن الطقس.";
"NSCameraUsageDescription" = "يستخدم nightjar الكاميرا لاستقبال إرسالات Blink — رسائل يعرضها جهاز آخر من أجهزتك كتسلسل متكرر من إطارات QR — فقط بينما تُبقي مستقبِل Blink مفتوحًا في تبويب Knocktalk. تُفكَّك الإطارات في لحظتها؛ ولا تُلتقط أي صور أو فيديو ولا تُخزَّن.";
"NFCReaderUsageDescription" = "يقرأ nightjar وسمًا تقرّبه من الهاتف عندما تستخدم Coin — وهو مفتاح مادي تدّعيه في تبويب EMCON — وعندما تُجري إحصاء EMCON للوسوم على بطاقاتك ووسومك الخاصة. لا تُقرأ الوسوم إلا في لحظة النقر؛ ويحتفظ Coin ببصمة (hash) فقط، ولا يحتفظ الإحصاء بشيء سوى ما يعرضه لك.";
"NSMicrophoneUsageDescription" = "يستمع nightjar إلى إرسالات Chirp — رسائل قصيرة يرسلها جهاز آخر من أجهزتك كنغمات مسموعة — فقط بينما تُبقي مستمِع Chirp مفتوحًا في تبويب Knocktalk. لا يُسجَّل شيء ولا يُخزَّن؛ وتُفكَّك النغمات في لحظتها ثم تُنسى.";
"NSHealthShareUsageDescription" = "يقرأ nightjar القراءات التي تجمعها Apple Watch الخاصة بك بالفعل — معدل ضربات القلب، والأكسجين في الدم، والتنفس، وحرارة المعصم، والنوم — لعرض حالة المشغّل إلى جانب حالة المنزل. إنه يقرأ فقط؛ فلا يُكتب شيء في بياناتك الصحية، ولا يغادر شيء هذا الهاتف.";
