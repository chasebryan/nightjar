/* Permission prompts, in the operator's own tongue. */
"NSBluetoothAlwaysUsageDescription" = "nightjar आपके आस-पास के Bluetooth डिवाइसों को सुनता है और जो कुछ सुनता है उसे लॉग करता है। यदि आप Send टैब का उपयोग करते हैं, तो यह आपके द्वारा टाइप किया गया पेलोड विज्ञापित भी कर सकता है और आपके चुने हुए डिवाइसों पर लिख भी सकता है। सुनना कभी किसी चीज़ से कनेक्ट नहीं होता।";
"NSLocalNetworkUsageDescription" = "nightjar आपके स्थानीय नेटवर्क पर मौजूद डिवाइसों को पेलोड भेजता है और उनसे पेलोड प्राप्त करता है — केवल उन पतों पर जिन्हें आप टाइप करते हैं, और केवल तब जब ऐप खुला हो।";
"NSLocationWhenInUseUsageDescription" = "nightjar उपयोग के दौरान आपके स्थान का उपयोग दो चीज़ों के लिए करता है: इसका कंपास, जो आपकी दिशा और यात्रा की दिशा का उपयोग करके आपको उस Bluetooth डिवाइस की ओर इंगित करता है जिसे इसका कान सुन रहा है, जब आप उसकी ओर चल रहे होते हैं; और Skelli की स्थान-बोध क्षमता, जो उसे यह बताने देती है कि आप दुनिया में कहाँ हैं और आपका स्थानीय समय व मौसम पढ़ने देती है। आपका स्थान कभी संग्रहीत नहीं किया जाता। निर्देशांक मौसम सेवा को केवल उसी क्षण भेजे जाते हैं जब आप Skelli से मौसम के बारे में पूछते हैं।";
"NSCameraUsageDescription" = "nightjar कैमरे का उपयोग Blink प्रसारण प्राप्त करने के लिए करता है — संदेश जो आपका कोई अन्य डिवाइस QR फ़्रेमों के एक लूपिंग अनुक्रम के रूप में दिखाता है — केवल तब, जब आप Knocktalk टैब में Blink रिसीवर को खुला रखते हैं। फ़्रेम उसी क्षण डीकोड किए जाते हैं; कोई फ़ोटो या वीडियो न लिया जाता है, न संग्रहीत किया जाता है।";
"NFCReaderUsageDescription" = "nightjar उस टैग को पढ़ता है जिसे आप फ़ोन के पास रखते हैं, जब आप Coin का उपयोग करते हैं — एक भौतिक कुंजी जिसे आप EMCON टैब में क्लेम करते हैं — और जब आप अपने ही कार्डों और टैगों पर EMCON टैग जनगणना चलाते हैं। टैग केवल उसी क्षण पढ़े जाते हैं जब आप टैप करते हैं; Coin केवल एक हैश रखता है, और जनगणना उसके अलावा कुछ नहीं रखती जो वह आपको दिखाती है।";
"NSMicrophoneUsageDescription" = "nightjar Chirp प्रसारणों को सुनता है — छोटे संदेश जो आपका कोई अन्य डिवाइस श्रव्य टोन के रूप में भेजता है — केवल तब, जब आप Knocktalk टैब में Chirp लिसनर को खुला रखते हैं। कुछ भी रिकॉर्ड या संग्रहीत नहीं किया जाता; टोन उसी क्षण डीकोड किए जाते हैं और भुला दिए जाते हैं।";
"NSHealthShareUsageDescription" = "nightjar उन रीडिंग्स को पढ़ता है जो आपकी Apple Watch पहले से एकत्र करती है — हृदय गति, रक्त ऑक्सीजन, श्वास, कलाई का तापमान और नींद — ताकि घर की स्थिति के साथ-साथ ऑपरेटर की स्थिति दिखाई जा सके। यह केवल पढ़ता है; आपके स्वास्थ्य डेटा में कुछ भी नहीं लिखा जाता, और इस फ़ोन से कुछ भी बाहर नहीं जाता।";
