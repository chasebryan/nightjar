{
  "version": 1,
  "ruleCases": [
    {
      "name": "followup-basic",
      "input": "contains Redis => followup Redis PING (RESP)",
      "expected": [
        {
          "matcher": {
            "contains": "redis"
          },
          "action": {
            "followup": "Redis PING (RESP)"
          }
        }
      ],
      "matchTests": [
        {
          "text": "Redis 7.2",
          "port": 6379,
          "matches": [
            true
          ]
        },
        {
          "text": "memcached",
          "port": 6379,
          "matches": [
            false
          ]
        }
      ]
    },
    {
      "name": "mixed-block",
      "input": "# house rules\n\ncontains nginx => tag web\nport 22 => tag ssh\ncontains openssh => stop\n",
      "expected": [
        {
          "matcher": {
            "contains": "nginx"
          },
          "action": {
            "tag": "web"
          }
        },
        {
          "matcher": {
            "port": 22
          },
          "action": {
            "tag": "ssh"
          }
        },
        {
          "matcher": {
            "contains": "openssh"
          },
          "action": {
            "stop": true
          }
        }
      ],
      "matchTests": [
        {
          "text": "nginx/1.24",
          "port": 80,
          "matches": [
            true,
            false,
            false
          ]
        },
        {
          "text": "OpenSSH_9.3",
          "port": 22,
          "matches": [
            false,
            true,
            true
          ]
        },
        {
          "text": "OpenSSH_9.3",
          "port": 80,
          "matches": [
            false,
            false,
            true
          ]
        }
      ]
    },
    {
      "name": "garbage-rejected",
      "input": "hello world\ncontains => followup\n=> tag x\nport abc => tag y\ncontains x => frobnicate y\ncontains x => followup",
      "expected": [],
      "matchTests": []
    },
    {
      "name": "keyword-case-needle-lowered-label-kept",
      "input": "Contains NGINX => TAG Web",
      "expected": [
        {
          "matcher": {
            "contains": "nginx"
          },
          "action": {
            "tag": "Web"
          }
        }
      ],
      "matchTests": [
        {
          "text": "nginx",
          "port": 80,
          "matches": [
            true
          ]
        }
      ]
    },
    {
      "name": "whitespace-tolerant",
      "input": "  contains   ssh   =>   tag   shell  ",
      "expected": [
        {
          "matcher": {
            "contains": "ssh"
          },
          "action": {
            "tag": "shell"
          }
        }
      ],
      "matchTests": []
    },
    {
      "name": "comments-and-blanks-only",
      "input": "# nothing here\n\n   \n#contains x => tag y\n",
      "expected": [],
      "matchTests": []
    },
    {
      "name": "port-and-contains",
      "input": "port 6379 => followup Redis PING (RESP)\ncontains redis => tag cache",
      "expected": [
        {
          "matcher": {
            "port": 6379
          },
          "action": {
            "followup": "Redis PING (RESP)"
          }
        },
        {
          "matcher": {
            "contains": "redis"
          },
          "action": {
            "tag": "cache"
          }
        }
      ],
      "matchTests": [
        {
          "text": "Redis version 7",
          "port": 6379,
          "matches": [
            true,
            true
          ]
        },
        {
          "text": "Redis",
          "port": 6380,
          "matches": [
            false,
            true
          ]
        },
        {
          "text": "memcached",
          "port": 6379,
          "matches": [
            true,
            false
          ]
        },
        {
          "text": "",
          "port": 80,
          "matches": [
            false,
            false
          ]
        }
      ]
    },
    {
      "name": "duplicates-preserved-in-order",
      "input": "contains a => tag one\ncontains a => tag two",
      "expected": [
        {
          "matcher": {
            "contains": "a"
          },
          "action": {
            "tag": "one"
          }
        },
        {
          "matcher": {
            "contains": "a"
          },
          "action": {
            "tag": "two"
          }
        }
      ],
      "matchTests": [
        {
          "text": "a",
          "port": 1,
          "matches": [
            true,
            true
          ]
        },
        {
          "text": "b",
          "port": 1,
          "matches": [
            false,
            false
          ]
        }
      ]
    }
  ],
  "analyzeCases": [
